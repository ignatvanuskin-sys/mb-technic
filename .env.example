# MB TECHNIC — переменные окружения (скопируйте в .env.local, а для Vercel — в Project Settings → Environment Variables)

# ── Обязательно перед публикацией ────────────────────────────────────────────

# Пароль для входа в панель заявок /admin.
# Пока переменная не задана, используется демо-пароль "mb-technic", и в интерфейсе
# показывается предупреждение. Задайте свой пароль перед публикацией сайта.
ADMIN_PASSWORD=

# Публичный адрес сайта — используется в canonical, Open Graph, sitemap и robots.
# Укажите реальный домен или адрес деплоя (например, адрес проекта в Vercel).
NEXT_PUBLIC_SITE_URL=https://mbtechnic.kz

# ── Хранилище заявок ─────────────────────────────────────────────────────────
# На Vercel (и любом serverless-хостинге) файловая система только для чтения,
# поэтому заявки нужно хранить во внешнем хранилище. Подойдёт бесплатный тариф
# Vercel KV / Upstash Redis — вставьте значения из панели хранилища:
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Альтернативные имена переменных (Upstash напрямую) тоже поддерживаются:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Уведомления о заявках (опционально, но рекомендуется) ────────────────────
# Каждая новая заявка приходит сообщением в Telegram. Если хранилище недоступно,
# заявка всё равно доходит до сервиса — данные не теряются.
# Бота создайте у @BotFather, chat_id — у @userinfobot.
#
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
